# Configuración de Base de Datos PostgreSQL
# IMPORTANTE: Cambia USE_POSTGRES a True para conectar con PostgreSQL.
# Si lo dejas en False, Django usará SQLite (solo para pruebas locales rápidas).
USE_POSTGRES=True
DB_NAME=servitech
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
