# =============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (ServiTech)
# Copia este archivo como '.env' en la raíz y ajusta tus credenciales locales.
# NUNCA subas el archivo '.env' a Git.
# =============================================================================

# Base de Datos: True para PostgreSQL, False para SQLite local (desarrollo rápido)
USE_POSTGRES=False

# Configuración de PostgreSQL (solo requerida si USE_POSTGRES=True)
DB_NAME=servitech
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# Configuración de Correo Electrónico
# Para desarrollo local (muestra correos en consola sin enviar):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para envío real mediante Gmail (descomentar y completar si es necesario):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_password_de_aplicacion
# DEFAULT_FROM_EMAIL=ServiTech <tu_correo@gmail.com>
